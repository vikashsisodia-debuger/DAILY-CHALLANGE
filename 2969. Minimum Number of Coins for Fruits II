class Pair {
    int value;
    int idx;
    Pair(int value,int idx) {
        this.value = value;
        this.idx = idx;
    }
}
class Solution {
    public int minimumCoins(int[] arr) {
        int n = arr.length;
        if(n == 1) {return arr[0];}
        PriorityQueue<Pair> PQ = new PriorityQueue<>((a,b) -> a.value - b.value);
        PQ.add(new Pair(0,n + 1));
        int dp[] = new int[n];
        for(int i = n - 1;i >= 0;i--) {
            int range = (i + 1) + (i + 1) + 1;
            while(!PQ.isEmpty() && PQ.peek().idx > range) {PQ.poll();}
            int ans = arr[i] + PQ.peek().value;
            dp[i] = ans;
            PQ.add(new Pair(ans,i + 1));
        }
        System.out.print(Arrays.toString(dp));
        return dp[0];
    }
}
