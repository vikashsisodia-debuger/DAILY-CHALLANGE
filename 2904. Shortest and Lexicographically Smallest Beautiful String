class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        String str = "";
        int n = s.length();
        int left = 0;
        int one = 0;
        for(int i = 0;i < n;i++) {
            char ch = s.charAt(i);
            if(ch == '1') {
                one += 1;
            }
            while(one >= k) {
                if(one == k) {
                    // Now make a substring
                    String sub = s.substring(left,i + 1);
                    if(str.isEmpty() || sub.length() < str.length()) {
                        str = sub;
                    }else if(str.length() == sub.length()) {
                        if(sub.compareTo(str) < 0) {
                            str = sub;
                        }
                    }
                }
                if(s.charAt(left) == '1') {
                    one -= 1;
                }
                left += 1;
            }
        }
        return str;
    }
}
