class Solution {
    public int minimumDeletions(int[] arr) {
        int minIndex = 0;
        int maxIndex = 0;
        int min = arr[0];
        int max = arr[0];
        int n = arr.length;
        for(int i = 1;i < n;i++) {
            if(arr[i] > max) {
                max = arr[i];
                maxIndex = i;
            }
            if(arr[i] < min) {
                min = arr[i];
                minIndex = i;
            }
        }
        // Now check for all three cases
        // first left to right 
        int caseOneAns = 0;
        int findBoth = 0;
        int leftFirst = -1;
        for(int i = 0;i < n;i++) {
            if(i == minIndex || i == maxIndex) {
                if(leftFirst == -1) {
                    leftFirst = i + 1;
                }
            }
            if(i == minIndex) {findBoth++;}
            if(i == maxIndex) {findBoth++;}
            if(findBoth == 2) {caseOneAns = i + 1;break;}
        }
        // second right to left
        int caseTwoAns = 0;
        findBoth = 0;
        int rightFirst = -1;
        for(int i = n - 1;i >= 0;i--) {
            if(i == minIndex || i == maxIndex) {
                if(rightFirst == -1) {
                    rightFirst = (n - i);
                }
            }
            if(i == minIndex) {findBoth++;}
            if(i == maxIndex) {findBoth++;}
            if(findBoth == 2) {caseTwoAns = (n - i);break;}
        }
        // now left to right + right to left
        int caseThreeAns = leftFirst + rightFirst;
        return Math.min(caseOneAns,Math.min(caseTwoAns,caseThreeAns));
    }
}
