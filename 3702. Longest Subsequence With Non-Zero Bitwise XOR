class Solution {
    public int longestSubsequence(int[] nums) {
        int xor = nums[0];
        HashSet<Integer> set = new HashSet<>();
        for(int num : nums) {set.add(num);}
        for(int i = 1;i < nums.length;i++) {
            xor ^= nums[i];
        }
        if(xor != 0) {return nums.length;}
        if(set.size() == 1) {
            for(int k : set) {
                if(k == 0) {return 0;}
            }
        }
        return nums.length - 1;
    }
}
