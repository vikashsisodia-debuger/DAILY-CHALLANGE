class Solution {
    public int[] nodesBetweenCriticalPoints(ListNode head) {
        int idx = 1;ListNode temp = head.next;ListNode prev = head;
        int first = -1,last = -1;
        int min = Integer.MAX_VALUE;
        int prevIdx = -1;
        while(temp != null && temp.next != null) {
            if((temp.val < prev.val && temp.val < temp.next.val) || (temp.val > prev.val && temp.val > temp.next.val)) {
                if(first == -1 || prevIdx == -1) {
                    first = idx;
                    prevIdx = idx;
                }else{
                    last = idx;
                    min = Math.min(min,idx - prevIdx);
                    prevIdx = idx;
                }
            }
            idx++;
            prev = temp;
            temp = temp.next;
        }
        if(first != -1 && last != -1) {
            return new int[]{min,last - first};
        }
        return new int[]{-1,-1};
    }
}
