class Solution {
    static int MOD = 1000000007;
    public int[] sumAndMultiply(String str, int[][] arr) {
        long pow[] = new long[str.length() + 1];
        pow[0] = 1;
        for(int i = 1;i <= str.length();i++) {
            pow[i] = (pow[i - 1] * 10) % MOD;
        }
        int n = str.length();
        long digits[] = new long[n + 1];
        long digitSum[] = new long[n + 1];
        int countDigits[] = new int[n + 1];
        long num = 0;
        long sum = 0;
        int count = 0;
        for(int i = 0;i < n;i++) {
            int digit = str.charAt(i) - '0';
            if(digit > 0) {
                num = (num * 10 + digit) % MOD;
                num = num % MOD;
                sum = (sum + digit) % MOD;
                count++;
            }
            digits[i + 1] = num;
            digitSum[i + 1] = sum;
            countDigits[i + 1] = count;
        }
        int ans[] = new int[arr.length];
        int idx = 0;
        for(int Q[] : arr) {
            int left = Q[0];int right = Q[1];
            int digitCount = (countDigits[right + 1] - countDigits[left]) % MOD;
            long digitsSum = (digitSum[right + 1] - digitSum[left] + MOD) % MOD;
            long number = ((digits[right + 1] - (digits[left] * pow[digitCount]) % MOD) % MOD + MOD) % MOD;
            long answer = ((number % MOD) * (digitsSum % MOD)) % MOD;
            ans[idx++] = (int)answer;
        }
        return ans;
    }
}
