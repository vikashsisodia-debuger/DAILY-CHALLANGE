class Solution {
    public int[] validSequence(String s, String t) {
        int n = s.length();
        int count = 0;
        int idx = t.length() - 1;
        int suffix[] = new int[n + 1];
        suffix[n] = Integer.MIN_VALUE;
        for(int i = n - 1;i >= 0;i--) {
            if(idx < 0) {
                suffix[i] = count;
                continue;
            }
            if(s.charAt(i) == t.charAt(idx)) {
                count++;
                idx--;
            }
            suffix[i] = count;
        }
        idx = 0;
        int len = t.length();
        int ans[] = new int[len];
        boolean oneChance = true;
        // Now Start Checking The Subsequence
        for(int i = 0;i < n;i++) {
            if(idx == len) {break;}
            if(s.charAt(i) == t.charAt(idx)) {
                ans[idx] = i;
                idx++;
            }else{
                // Now check Ones;
                if(oneChance) {
                    if(suffix[i + 1] >= len - idx - 1) {
                        ans[idx] = i;
                        oneChance = false;
                        idx++;
                    }
                }
            }
        }
        return idx < len ? new int[]{} : ans;
    }
}
