class Pair {
    int sum;
    int count;
    Pair(int sum,int count) {
        this.sum = sum;
        this.count = count;
    }
}
class Solution {
    static Pair[][] dp;
    public int[] pathsWithMaxScore(List<String> board) {
        int arr[][] = new int[board.size()][board.size()];
        for(int row = 0;row < board.size();row++) {
            for(int col = 0;col < board.get(row).length();col++) {
                if(board.get(row).charAt(col) == 'S' || board.get(row).charAt(col) == 'E') {
                    arr[row][col] = 0;
                }else if(board.get(row).charAt(col) == 'X') {
                    arr[row][col] = -1;
                }else{
                    arr[row][col] = board.get(row).charAt(col) - '0';
                }
            }
        }
        dp = new Pair[arr.length][arr.length];
        Pair ans = solve(arr,0,0);
        if(ans.sum == Integer.MIN_VALUE) {
            return new int[]{0,0};
        }
        return new int[]{ans.sum,ans.count};
    }
    static Pair solve(int arr[][],int row,int col) {
        if(row < 0 || col < 0 || row >= arr.length || col >= arr[row].length || arr[row][col] == -1) {
            return new Pair(Integer.MIN_VALUE, 0);
        }
        if(row == arr.length - 1 && col == arr[row].length - 1) {
            return new Pair(0, 1);
        }
        if(dp[row][col] != null) {return dp[row][col];}
        Pair right = solve(arr, row, col + 1);
        Pair bottom = solve(arr, row + 1, col);
        Pair diagonal = solve(arr, row + 1, col + 1);
        if(right.sum == Integer.MIN_VALUE && bottom.sum == Integer.MIN_VALUE && diagonal.sum == Integer.MIN_VALUE) {
            Pair ans = new Pair(Integer.MIN_VALUE, 0);
            dp[row][col] = ans;
            return ans;
        }
        int maxSum = 0;
        int maxFreq = 0;
        if(right.sum != Integer.MIN_VALUE) {maxSum = Math.max(maxSum,arr[row][col] + right.sum);}
        if(bottom.sum != Integer.MIN_VALUE) {maxSum = Math.max(maxSum,arr[row][col] + bottom.sum);}
        if(diagonal.sum != Integer.MIN_VALUE) {maxSum = Math.max(maxSum,arr[row][col] + diagonal.sum);}
        if(right.sum != Integer.MIN_VALUE && arr[row][col] + right.sum == maxSum) {maxFreq = (maxFreq + right.count) % 1000000007;}
        if(bottom.sum != Integer.MIN_VALUE && arr[row][col] + bottom.sum == maxSum) {maxFreq = (maxFreq + bottom.count) % 1000000007;}
        if(diagonal.sum != Integer.MIN_VALUE && arr[row][col] + diagonal.sum == maxSum) {maxFreq = (maxFreq + diagonal.count) % 1000000007;}
        Pair ans = new Pair(maxSum,maxFreq);
        dp[row][col] = ans;
        return ans;
    }
}
