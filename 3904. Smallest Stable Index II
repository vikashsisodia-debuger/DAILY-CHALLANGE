class Solution {
    public int firstStableIndex(int[] arr, int k) {
        int n = arr.length;
        int prefix[] = new int[n];
        int suffix[] = new int[n];
        int left = arr[0];
        prefix[0] = left;
        for(int i = 1;i < arr.length;i++) {
            left = Math.max(left,arr[i]);
            prefix[i] = left;
        }
        suffix[n - 1] = arr[n - 1];
        int right = arr[n - 1];
        for(int i = n - 2;i >= 0;i--) {
            right = Math.min(right,arr[i]);
            suffix[i] = right;
        }
        for(int i = 0;i < arr.length;i++) {
            int diff = prefix[i] - suffix[i];
            if(diff <= k) {return i;}
        }
        return -1;   
    }
}
