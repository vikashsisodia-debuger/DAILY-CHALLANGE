class Solution {
    public int removeCoveredIntervals(int[][] arr) {
        Arrays.sort(arr,(a,b) -> {
            if(a[0] == b[0]) {
                return b[1] - a[1];
            }else{
                return a[0] - b[0];
            }
        });
        int curr[] = arr[0];
        int count = 1;
        for(int i = 1;i < arr.length;i++) {
            if(arr[i][0] >= curr[0] && arr[i][1] <= curr[1]) {
                continue;
            }else{
                curr = arr[i];
                count++;
            }
        }
        return count;
    }
}
