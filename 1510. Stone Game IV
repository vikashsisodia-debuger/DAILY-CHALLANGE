class Solution {
    static Boolean[] dp;
    public boolean winnerSquareGame(int n) {
        dp = new Boolean[n + 1];
        boolean ans = solve(n);  
        return ans;
    }
    static boolean solve(int num) {
        if(dp[num] != null) {
            return dp[num];
        }
        for(int i = 1;i <= num;i++) {
            int squres = i * i;
            if((num - squres) == 0) {
                return dp[num] = true;
            }
            if(num - squres < 0) {return dp[num] = false;}
            if(!solve(num - squres)) {
                return dp[num] = true;
            }
        }
        return dp[num] = false;
    }
}
