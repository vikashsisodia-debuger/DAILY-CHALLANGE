class Solution {
    public int countSpecialIntegers(int[] arr) {
        HashMap<Integer,List<Integer>> map = new HashMap<>();
        HashMap<Integer,HashSet<Integer>> equal = new HashMap<>();
        int n = arr.length;
        for(int i = 0;i < n;i++) {
            int num = arr[i];
            map.putIfAbsent(num,new ArrayList<>());
            equal.putIfAbsent(num,new HashSet<>());
            if(map.get(num).size() == 0) {
                map.get(num).add(i);
            }else{
                int diff = i - map.get(num).getLast();
                equal.get(num).add(diff);
                map.get(num).add(i);
            }
        }
        int count = 0;
        for(int key : map.keySet()) {
            if(map.get(key).size() < 3) {continue;}
            if(equal.get(key).size() == 1) {count += 1;}
        }
        return count;
    }
}
