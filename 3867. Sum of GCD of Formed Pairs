class Solution {
    static long gdc(long first,long second) {
        while(second != 0) {
            long temp = first % second;
            first = second;
            second = temp;
        }
        return first;
    }
    public long gcdSum(int[] arr) {
        int prefix[] = new int[arr.length];
        prefix[0] = arr[0];
        int leftMax = arr[0];
        for(int i = 1;i < arr.length;i++) {
            leftMax = Math.max(leftMax,arr[i]);
            prefix[i] = leftMax;
        }
        long gdcArr[] = new long[arr.length];
        for(int i = 0;i < arr.length;i++) {
            gdcArr[i] = gdc(arr[i],prefix[i]);
        }
        long sum = 0;
        Arrays.sort(gdcArr);
        int mid = arr.length / 2;
        int last = arr.length - 1;
        for(int i = 0;i < mid;i++) {
            sum += gdc(gdcArr[i],gdcArr[last]);
            last--;
        }
        return sum;
    }
}
